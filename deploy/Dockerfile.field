# The collectors' app — a separate origin from the traveller's, deliberately.
#
# A PWA's identity is its origin (decision 012), and these two share nothing: different people,
# different data, different lifetime. Putting the collectors' tool inside the traveller app's
# service worker scope would also mean our own staff tool could evict a traveller's offline pack.
FROM node:22-alpine AS build
WORKDIR /repo

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/ packages/
COPY apps/field/ apps/field/
RUN npm ci --workspace @saathi/field --include-workspace-root
RUN npm run build --workspace @saathi/field

FROM nginx:1.27-alpine
ENV NGINX_ENVSUBST_FILTER=PORT
ENV PORT=8080
COPY deploy/nginx.field.conf /etc/nginx/templates/default.conf.template
COPY --from=build /repo/apps/field/dist /usr/share/nginx/html
EXPOSE 8080
