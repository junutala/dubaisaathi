# The collectors' app — a separate origin from the traveller's, deliberately.
#
# A PWA's identity is its origin (decision 012), and these two share nothing: different people,
# different data, different lifetime. Putting the collectors' tool inside the traveller app's
# service worker scope would also mean our own staff tool could evict a traveller's offline pack.
FROM node:22-alpine AS build
WORKDIR /repo

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/ packages/
COPY apps/field/ apps/field/
RUN npm ci --workspace @saathi/field --include-workspace-root

# Which build this is. `.git` is not in the image, so the commit comes from Railway's own build
# argument; a local build has neither and says "dev", which is exactly what it is.
ARG RAILWAY_GIT_COMMIT_SHA=""
RUN VITE_BUILD_SHA="$RAILWAY_GIT_COMMIT_SHA" \
    VITE_BUILD_TIME="$(date -u '+%d %b %H:%M')" \
    npm run build --workspace @saathi/field

# The menu reader's engine, on our own origin.
#
# tesseract.js otherwise fetches its worker, its wasm and its language data from a CDN at the
# moment a collector taps "Read the menu" — a third-party request from a street in Meena Bazaar,
# and a staff tool that stops working when somebody else's host has a bad day. The worker and the
# wasm come out of the packages already installed above; only the trained data is downloaded, the
# same arrangement the Hindi speech model uses in deploy/Dockerfile.
#
# The `_fast` data, not the standard set: 1.9 MB against 10.9 MB, and quicker on a phone. The
# accuracy it gives up is on handwriting and damaged scans; a printed menu board is the case it
# handles well. A collector on mobile data should not fetch 11 MB to read a laminated card.
FROM node:22-alpine AS ocr
RUN apk add --no-cache curl
WORKDIR /ocr
COPY --from=build /repo/node_modules/tesseract.js/dist/worker.min.js ./
COPY --from=build /repo/node_modules/tesseract.js-core/ ./core/
RUN cp core/*.wasm.js core/*.wasm ./ 2>/dev/null || cp core/*.wasm.js ./; \
    curl -fsSL --retry 3 -o eng.traineddata.gz \
      https://tessdata.projectnaptha.com/4.0.0_fast/eng.traineddata.gz; \
    rm -rf core; \
    ls -la /ocr

FROM nginx:1.27-alpine
ENV NGINX_ENVSUBST_FILTER=PORT
ENV PORT=8080
COPY deploy/nginx.field.conf /etc/nginx/templates/default.conf.template
COPY --from=build /repo/apps/field/dist /usr/share/nginx/html
COPY --from=ocr /ocr /usr/share/nginx/html/ocr
EXPOSE 8080
